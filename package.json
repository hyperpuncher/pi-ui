{
	"name": "@hyperpuncher/pi-ui",
	"version": "0.65.0",
	"description": "keyboard-first minimal gui for pi",
	"homepage": "https://pi-ui.app",
	"bugs": "https://github.com/hyperpuncher/pi-ui/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperpuncher/pi-ui.git"
	},
	"bin": {
		"pi-ui": "dist/npm/server-main.js"
	},
	"files": [
		"dist/npm",
		"static",
		"!static/app"
	],
	"type": "module",
	"imports": {
		"#src/*": "./src/*",
		"#static/*": "./static/*",
		"#tests/*": "./tests/*",
		"#testing/*": "./tests/src/testing/*",
		"#tools/*": "./tools/*",
		"#package": "./package.json",
		"#testing/assertions": "./tests/src/testing/assertions.ts",
		"#testing/temp": "./tests/src/testing/temp.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bun run assets:build && bun src/server-main.ts",
		"assets:build": "bun scripts/generate-icons.ts && bun scripts/build-assets.ts",
		"build": "bun run assets:build && bun scripts/build.ts",
		"npm:build": "bun run assets:build && bun scripts/build-npm.ts",
		"prepack": "bun run npm:build",
		"run": "./dist/pi-ui",
		"release": "bun scripts/release.ts",
		"schema:build": "bun scripts/generate-config-schema.ts",
		"schema:check": "bun scripts/generate-config-schema.ts --check",
		"fmt": "bun run schema:build && dsfmt --write . && bun fmt",
		"fmt:check": "bun run schema:check && bun fmt --no-script --check",
		"lint": "bunx oxlint && bun run lint:css",
		"lint:css": "bunx stylelint \"src/**/*.css\"",
		"lint:fix": "bunx oxlint --fix && bun run lint:css --fix",
		"check": "bun run schema:check && bun check",
		"test": "bun test --parallel=8",
		"audit": "bunx fallow audit"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.5.1",
		"@earendil-works/pi-coding-agent": "^1.5.1",
		"@earendil-works/pi-schema": "^1.5.1",
		"@earendil-works/pi-tui": "^1.5.1",
		"@iconify-json/lucide": "^1.2.153",
		"@kitajs/html": "5.0.0-next.1",
		"@oxlint/plugins": "1.93.0",
		"@pierre/diffs": "^1.6.4",
		"@pierre/highlights": "0.5.0",
		"@pierre/trees": "^1.0.0-beta.6",
		"@starfederation/datastar-sdk": "^1.0.0",
		"@types/bun": "^1.4.4",
		"open-props": "^1.7.23",
		"oxlint": "1.93.0",
		"pele": "1.13.0",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"patchedDependencies": {
		"@earendil-works/pi-coding-agent@1.5.0": "patches/@earendil-works%2Fpi-coding-agent@1.5.0.patch"
	}
}
